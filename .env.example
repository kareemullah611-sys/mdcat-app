# Copy to .env and adjust — see README.md "Local setup"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mdcat_app"

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""

# Local development. In production, mount persistent storage here.
TEXTBOOK_STORAGE_DIR="storage/textbooks"

# Seed-only super admin (change before deploying publicly)
SEED_ADMIN_EMAIL="admin@mdcat.pk"
SEED_ADMIN_PASSWORD="ChangeMe123!"
